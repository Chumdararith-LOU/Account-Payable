# Server-specific env. See docs/DEPLOYMENT.md.
# Copy to .env.server on the deploy machine; never commit .env.server.
# Used by docker-compose.server.yml for BOTH the Postgres container and
# the API's DATABASE_URL (they must match).
APMATCH_DB_PASSWORD=<set-me>
# For an external psql connection from the host only (requires exposing
# 5434 manually); the API container does not use this.
DATABASE_URL=postgresql+psycopg://apmatch:<set-me>@localhost:5434/apmatch
APMATCH_API_KEY=<generate-with-python-secrets-token-hex-32>
APMATCH_LOG_LEVEL=INFO
# The URL the demo machine uses to reach the API (for docs only):
APMATCH_PUBLIC_URL=http://100.127.105.9:8001
