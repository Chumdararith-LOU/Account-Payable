# Copy to .env and set real values. .env is gitignored.
#
# DATABASE_URL here uses localhost:5433 — that is the host-mapped port for
# running the test suite on the host. docker-compose.yml's `api` service
# overrides it with postgres:5432 (the compose-internal hostname + the
# container's internal port). Both are correct in their own context.
DATABASE_URL=postgresql+psycopg://apmatch:apmatch_dev_only@localhost:5433/apmatch
# For local dev, generate a random key:
#   python -c "import secrets; print(secrets.token_hex(32))"
# The api service requires this (compose ${APMATCH_API_KEY:?...}); a container
# that starts with no API key is a security hole.
APMATCH_API_KEY=change-me-this-is-a-dev-placeholder-key
APMATCH_LOG_LEVEL=INFO
